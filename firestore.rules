rules_version = '2';

// Firestore security rules for MuDRing.
// Schema:
//   users/{uid}
//   users/{uid}/watchMetrics/{metricId}
//   users/{uid}/voiceSessions/{sessionId}
//   users/{uid}/settings/{settingsId}
//
// Each user can only read/write their own data.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /watchMetrics/{metricId} {
        allow read, write: if isOwner(uid);
      }

      match /voiceSessions/{sessionId} {
        allow read, write: if isOwner(uid);
      }

      match /settings/{settingsId} {
        allow read, write: if isOwner(uid);
      }

      match /subchecks/{subcheckId} {
        allow read, write: if isOwner(uid);
      }

      match /checkpoints/{checkpointId} {
        allow read, write: if isOwner(uid);
      }

      match /dailySummaries/{summaryId} {
        allow read, write: if isOwner(uid);
      }

      // MFA remembered-device records — owner can read; only Cloud Functions write.
      match /mfaDevices/{deviceId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // Email-OTP state — managed exclusively by Cloud Functions.
    match /emailOtps/{uid} {
      allow read, write: if false;
    }

    // Trigger Email extension queue — write-only via Cloud Functions.
    match /mail/{docId} {
      allow read, write: if false;
    }
  }
}
